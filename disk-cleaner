#!/usr/bin/env python3
"""GUI to find and delete disposable files (caches, trash, old packages, big files).

disk-cleaner          GUI
disk-cleaner --list   print candidates and problems, no GUI (smoke test)

Safety: nothing outside $HOME is ever unlinked directly, protected dirs are refused, and anything the
package manager/root owns runs as an allow-listed pacman/paru/apt/dnf/sudo command in a terminal so
the tool itself asks for confirmation. Failures are explained in the GUI; nothing is logged to the CLI.
"""
import collections, functools, glob, math, os, pwd, re, shutil, stat, subprocess, sys, tempfile, threading, traceback, warnings
from pathlib import Path

warnings.filterwarnings("ignore")  # GTK3 style-context getters etc.

HOME = os.path.expanduser("~")
CACHE = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")
DATA = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share")
TRASH = os.path.join(DATA, "Trash")
PARU = os.path.join(CACHE, "paru")
home = lambda *a: os.path.join(HOME, *a)
BIG = "500M"  # large-file search threshold (find -size syntax)
# terminal -> args before the command; first one found wins ($TERMINAL first)
TERMS = {"terminator": ["-u", "-x"], "xfce4-terminal": ["--disable-server", "-x"], "gnome-terminal": ["--wait", "--"],
         "konsole": ["--nofork", "-e"], "alacritty": ["-e"], "kitty": [], "foot": [], "xterm": ["-e"],
         "x-terminal-emulator": ["-e"]}
# dataviz reference palette (validated light/dark, 7 slots) + neutral for "Other"
PALETTE = {"light": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6"],
           "dark": ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#008300", "#9085e9"]}
OTHER = "#8a8a85"

Issue = collections.namedtuple("Issue", "item raw cause hint")
Row = collections.namedtuple("Row", "label target size kind note")  # kind: rm | clear | cmd
ISSUES = {"scan": [], "run": []}


class Refused(Exception):
    pass


class DeleteError(Exception):
    def __init__(self, errors):  # [(path, exception)]
        super().__init__(f"{len(errors)} errors")
        self.errors = errors


class CmdError(Exception):
    def __init__(self, cmd, rc, err):
        super().__init__(err.strip() or ("terminal closed before the command finished" if rc is None
                                         else f"exit code {rc} (declined at the prompt?)"))
        self.cmd, self.rc = cmd, rc


# ---------------------------------------------------------------- explaining failures
DENIED = r"Permission denied|Operation not permitted|EACCES|EPERM"
RULES = [  # (regex on the raw message, likely cause, what to do)
    (r"unable to lock database|could not lock|Could not get lock|dpkg frontend lock|lock .*held|waiting for .*lock|db\.lck",
     "Another package manager is running (or crashed and left a lock file).",
     "Close it and retry. If none is running, remove the stale lock (pacman: sudo rm /var/lib/pacman/db.lck)."),
    (r"a password is required|Authentication failure|incorrect password|no tty present|not in the sudoers",
     "sudo authentication failed.", "Retry and type your password in the terminal; make sure your user is in wheel/sudo."),
    (r"target not found|Unable to locate package|No match for argument|no package .*installed|is not installed",
     "The package no longer exists or was already removed.", "Rescan and try again."),
    (r"breaks dependency|is required by|unmet dependenc|dependency problems|Problem: .*requires|Depends:",
     "Other installed packages still depend on it.", "Remove the dependents first, or leave this one installed."),
    (r"conflicting files|failed to commit transaction|file conflicts",
     "Files conflict with another package.", "Read the conflicting paths above and resolve them manually."),
    (r"no targets specified|nothing to do|Nothing to do|0 to remove",
     "Nothing left to remove (already clean).", "Rescan."),
    (r"command not found|No such file or directory.*(paru|yay|pacman|apt|dnf|journalctl|sudo)",
     "A required tool is not installed.", "Install it, or deselect this item."),
    (r"Read-only file system", "The filesystem is mounted read-only.", "Remount it read-write or check the disk (dmesg)."),
    (r"No space left", "The disk is completely full.", "Free a little space manually first (e.g. empty the trash)."),
    (r"busy|EBUSY", "The file is in use by a running program.", "Close the program using it (lsof +D <path>) and retry."),
    (r"Failed to (vacuum|rotate)|journal.*(Permission|denied)", "journalctl needs root.", "Run it via sudo in the terminal."),
]


def why_denied(path):
    """(cause, hint) for a permission error on path, from the real file state."""
    try:
        st = os.lstat(path)
    except OSError:
        st = None
    if st and st.st_uid != os.getuid():
        try:
            owner = pwd.getpwuid(st.st_uid).pw_name
        except KeyError:
            owner = str(st.st_uid)
        return f"The file is owned by '{owner}', not by you.", f"After checking the path: sudo rm -rf '{path}'"
    parent = os.path.dirname(path)
    if not os.access(parent, os.W_OK | os.X_OK):
        return "The parent directory is not writable.", f"chmod u+w '{parent}'"
    if st and stat.S_ISDIR(st.st_mode) and not os.access(path, os.R_OK | os.X_OK):
        return "The directory has no read/execute permission (e.g. mode 311).", f"chmod -R u+rwX '{path}'"
    return ("Permission denied by an immutable attribute, ACL or security module (SELinux/AppArmor).",
            "Check lsattr/getfacl; for immutable files: sudo chattr -i <path>")


def issue(item, raw, path=None):
    raw = " ".join(str(raw).split())[:400]
    if path and re.search(DENIED, raw):
        return Issue(item, raw, *why_denied(path))
    for rx, cause, hint in RULES:
        if re.search(rx, raw, re.I):
            return Issue(item, raw, cause, hint)
    return Issue(item, raw, "Unknown.", "Run the command by hand and read its output.")


def note_scan_errors(item, stderr):
    for line in stderr.splitlines():
        m = re.search(rf"'([^']+)': ({DENIED})", line) or re.search(rf"(/\S+): ({DENIED})", line)
        if m and m.group(1).startswith(HOME + os.sep):  # system dirs are handled by root commands: not actionable
            ISSUES["scan"].append(issue(item, line, m.group(1)))


# ---------------------------------------------------------------- safety
PKG = r"[\w@+][\w.+@:-]*"
ALLOWED_CMD = re.compile(
    rf"sudo pacman -Sc|sudo journalctl --vacuum-size=\d+[KMG]|(paru|yay|sudo pacman) -Rns (\$\(pacman -Qdtq\)|{PKG})"
    rf"|sudo apt-get (clean|autoremove --purge|remove {PKG})|sudo dnf (clean all|autoremove|remove {PKG})")
PKG_REMOVE = re.compile(rf"(?:paru|yay|sudo pacman) -Rns ({PKG})|sudo (?:apt-get|dnf) remove ({PKG})")
under = lambda p, root: p == root or p.startswith(root + os.sep)
PRIVATE = [os.path.realpath(home(d)) for d in (".ssh", ".gnupg", ".config", ".local")]  # nothing inside is ever offered
PROTECTED = PRIVATE + [os.path.realpath(x) for x in (*map(home, (
    ".password-store", ".mozilla", ".thunderbird", "Documents", "Desktop", "Pictures", "Music", "Videos", "Downloads",
    "src", ".xconfig")), CACHE, DATA, TRASH)]


def check_safe(target, kind):
    """Raise Refused unless every target is allow-listed. Defence in depth: scan() only yields safe rows."""
    if kind == "cmd":
        if not ALLOWED_CMD.fullmatch(target):
            raise Refused(f"command not on the allow-list: {target}")
        if (m := PKG_REMOVE.fullmatch(target)) and PM and protected_pkg(m[1] or m[2]):
            raise Refused(f"protected package: {m[1] or m[2]}")
        return
    for t in target.split("\n"):
        # a symlink is only unlinked, so judge where it lives; anything else by its real location
        p = os.path.abspath(t) if os.path.islink(t) else os.path.realpath(t)
        if p == HOME or not under(p, HOME):
            raise Refused(f"outside your home directory: {t}")
        if any(under(q, p) for q in PROTECTED):
            raise Refused(f"protected directory (or contains one): {t}")
        if os.path.ismount(p):
            raise Refused(f"mount point: {t}")


# ---------------------------------------------------------------- package managers
def out(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, env={**os.environ, "LC_ALL": "C"}).stdout
    except OSError:
        return ""


nums = lambda *c: sum(int(x) for x in out(*c).split() if x.isdigit())


def _pacman():
    helper = next((h for h in ("paru", "yay") if shutil.which(h)), "sudo pacman")
    unit = {"B": 1, "KiB": 1 << 10, "MiB": 1 << 20, "GiB": 1 << 30}
    return dict(
        name="pacman", cache_dir="/var/cache/pacman/pkg", clean="sudo pacman -Sc",
        remove=lambda p: f"{helper} -Rns {p}", autoremove=f"{helper} -Rns $(pacman -Qdtq)",
        owner=lambda f: out("pacman", "-Qqo", f).strip(), orphans=lambda: out("pacman", "-Qdtq").split(),
        size=lambda ps: sum(int(float(n) * unit[u]) for n, u in re.findall(r"Installed Size\s*:\s*([\d.]+) (\w+)", out("pacman", "-Qi", *ps))),
        critical=lambda p: p in out("pacman", "-Qqg", "base").split() or p.startswith("linux") or p in {"pacman", "paru", "yay", "sudo", "glibc", "systemd"},
        explicit=lambda p: p in out("pacman", "-Qqe").split())


def _apt():
    return dict(
        name="apt", cache_dir="/var/cache/apt/archives", clean="sudo apt-get clean",
        remove=lambda p: f"sudo apt-get remove {p}", autoremove="sudo apt-get autoremove --purge",
        owner=lambda f: out("dpkg", "-S", f).split(":")[0].split(",")[0].strip(),
        orphans=lambda: re.findall(r"^Remv (\S+)", out("apt-get", "-s", "autoremove"), re.M),
        size=lambda ps: 1024 * nums("dpkg-query", "-W", "-f", "${Installed-Size}\n", *ps),
        critical=lambda p: out("dpkg-query", "-W", "-f", "${Essential}", p) == "yes" or re.match(r"linux-(image|modules|generic)|apt$|dpkg$|sudo$", p),
        explicit=lambda p: p in out("apt-mark", "showmanual").split())


def _dnf():
    return dict(
        name="dnf", cache_dir="/var/cache/dnf", clean="sudo dnf clean all",
        remove=lambda p: f"sudo dnf remove {p}", autoremove="sudo dnf autoremove",
        owner=lambda f: out("rpm", "-qf", "--qf", "%{NAME}", f).strip() if os.path.exists(f) else "",
        orphans=lambda: out("dnf", "-q", "repoquery", "--unneeded").split(),
        size=lambda ps: nums("rpm", "-q", "--qf", "%{SIZE}\n", *ps),
        critical=lambda p: re.match(r"kernel|glibc|systemd|bash$|coreutils$|rpm$|dnf|sudo$|filesystem$", p),
        explicit=lambda p: False)


PM = next((f() for b, f in (("pacman", _pacman), ("apt-get", _apt), ("dnf", _dnf)) if shutil.which(b)), None)


@functools.lru_cache(None)
def self_packages():
    """Packages this program itself runs on: never offer to remove them."""
    files = [os.path.realpath(sys.executable)]
    try:
        import gi, cairo
        files += [gi.__file__, cairo.__file__]
    except ImportError:
        pass
    return {PM["owner"](f) for f in files} - {""}


def protected_pkg(pkg):
    return pkg in self_packages() or bool(PM["critical"](pkg))


# ---------------------------------------------------------------- scanning
def du(path):
    r = subprocess.run(["du", "-sxb", path], capture_output=True, text=True)
    note_scan_errors(path, r.stderr)
    return int(r.stdout.split()[0]) if r.stdout else 0


def human(n):
    for u in "BKMGT":
        if n < 1024 or u == "T":
            return f"{n:.1f} {u}" if u != "B" else f"{n} B"
        n /= 1024


def paru_artifacts(clone):
    """Top-level entries of each paru clone that git doesn't track (src/, pkg/, sources, built packages)."""
    out_ = []
    for d in glob.glob(os.path.join(clone, "*")):
        r = subprocess.run(["git", "-C", d, "ls-files", "-z"], capture_output=True)
        if r.returncode:
            continue  # not a git clone: leave alone
        keep = {".git"} | {f.split(b"/")[0].decode() for f in r.stdout.split(b"\0") if f}
        out_ += [e.path for e in os.scandir(d) if e.name not in keep]
    return out_


def scan():
    """Yield Row. kind: rm=delete paths, clear=empty dirs (keep them), cmd=allow-listed command run in a terminal."""
    ISSUES["scan"].clear()
    find = subprocess.Popen(  # slow: overlap it with the du/package queries below
        ["find", HOME, "-xdev", "(", "-path", CACHE, "-o", "-path", TRASH, ")", "-prune", "-o",
         "-type", "f", "-size", f"+{BIG}", "-printf", "%s\t%p\n"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if os.path.isdir(CACHE):
        for e in sorted(os.scandir(CACHE), key=lambda e: e.name):
            if e.path != PARU:  # see paru_artifacts
                yield Row(f"cache: {e.name}", e.path, du(e.path), "clear", "")
    for label, paths in [
        ("trash", [os.path.join(TRASH, "files"), os.path.join(TRASH, "info")]),
        ("npm cache", [home(".npm/_cacache")]),
        ("cargo registry cache", [home(".cargo/registry/cache")]),
    ]:
        if paths := [x for x in paths if os.path.isdir(x)]:
            yield Row(label, "\n".join(paths), sum(map(du, paths)), "clear", "")
    if build := paru_artifacts(os.path.join(PARU, "clone")):
        yield Row("paru build artifacts (untracked in clone/*)", "\n".join(build), sum(map(du, build)), "rm",
                  "Sources are downloaded again on the next build.")
    if PM:
        if os.path.isdir(PM["cache_dir"]):
            yield Row(f"{PM['name']} package cache", PM["clean"], du(PM["cache_dir"]), "cmd", "")
        if orphans := PM["orphans"]():
            yield Row(f"unneeded packages ({len(orphans)})", PM["autoremove"], PM["size"](orphans), "cmd",
                      "Read the package list the package manager prints before you confirm.")
    if shutil.which("journalctl") and os.path.isdir("/var/log/journal"):
        yield Row("systemd journal (keep 200M)", "sudo journalctl --vacuum-size=200M", du("/var/log/journal"), "cmd", "")
    stdout, stderr = find.communicate()
    note_scan_errors(HOME, stderr)
    seen = set()
    for line in stdout.splitlines():
        s, f = line.split("\t", 1)
        rel = os.path.relpath(f, HOME)
        if any(under(f, q) for q in PRIVATE):
            continue  # ssh/gnupg/config/local data: never offered
        owner = PM["owner"](f) if PM else ""
        if owner:  # package-owned: remove the package (with confirmation), never the file
            if owner in seen:
                continue
            seen.add(owner)
            if protected_pkg(owner):
                continue
            note = "Explicitly installed package." if PM["explicit"](owner) else ""
            yield Row(f"package {owner} (owns big file ~/{rel})", PM["remove"](owner), int(s), "cmd", note)
        else:
            hidden = any(c.startswith(".") for c in rel.split(os.sep))
            yield Row(f"big file: {rel}", f, int(s), "rm",
                      "Permanent. Inside hidden app data: deleting it may corrupt or reset that app." if hidden
                      else "Permanent. This looks like your own data.")


# ---------------------------------------------------------------- deleting
def run_in_terminal(cmd):
    term = next((t for t in [os.path.basename(os.environ.get("TERMINAL", "")), *TERMS]
                 if t in TERMS and shutil.which(t)), None)
    if not term:
        raise CmdError(cmd, 1, f"no terminal found ({', '.join(TERMS)}); run it by hand: {cmd}")
    script = ('bash -c "$1" 2> >(tee "$2/err" >&2); rc=$?; sleep 0.3; echo "$rc" > "$2/rc"; '
              'echo; read -rp "exit $rc - press Enter to close " _')
    with tempfile.TemporaryDirectory(ignore_cleanup_errors=True) as d:
        subprocess.run([term, *TERMS[term], "bash", "-c", script, "_", cmd, d],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        def rd(name):
            try:
                return Path(d, name).read_text()
            except FileNotFoundError:
                return ""
        rc = rd("rc").strip()
        if rc != "0":
            raise CmdError(cmd, int(rc) if rc else None, rd("err"))


def unlock(path):  # makepkg/go leave read-only (even unreadable) dirs
    subprocess.run(["chmod", "-R", "u+rwX", path], capture_output=True)


def delete(target, kind, unlocked=False):
    check_safe(target, kind)
    if kind == "cmd":
        return run_in_terminal(target)
    errors = []
    for t in target.split("\n"):
        if kind == "clear":  # empty the dir, keep the dir itself
            unlock(t)
            try:
                entries = list(os.scandir(t))
            except FileNotFoundError:
                continue
            except OSError as e:
                errors.append((t, e))
                continue
            for ent in entries:
                try:
                    delete(ent.path, "rm", unlocked=True)
                except DeleteError as x:
                    errors += x.errors
        elif os.path.isdir(t) and not os.path.islink(t):
            if not unlocked:
                unlock(t)
            shutil.rmtree(t, onerror=lambda f, path, ei: errors.append((path, ei[1])))
        else:
            try:
                os.unlink(t)
            except FileNotFoundError:
                pass
            except OSError as e:
                errors.append((t, e))
    if errors:
        raise DeleteError(errors)


def pie_slices(rows, pal):
    """Top len(pal) rows by size, the rest folded into one grey 'Other' slice. rows: (sel, label, size, ...)."""
    rows = sorted(rows, key=lambda r: -r[2])
    top, rest = rows[:len(pal)], rows[len(pal):]
    out = [dict(label=r[1], size=r[2], color=pal[i], rows=[r]) for i, r in enumerate(top)]
    if rest:
        out.append(dict(label=f"Other ({len(rest)} items)", size=sum(r[2] for r in rest), color=OTHER, rows=rest))
    return out


def issues_text(items):
    return "\n\n".join(f"■ {i.item}\n  What happened: {i.raw}\n  Likely cause:  {i.cause}\n  What to do:    {i.hint}"
                        for i in items)


def run_job(row):
    """Delete one row; return a list of Issue (empty on success)."""
    try:
        delete(row.target, row.kind)
    except DeleteError as e:
        first = [issue(row.label, x, p) for p, x in e.errors[:3]]
        if len(e.errors) > 3:
            first.append(Issue(row.label, f"...and {len(e.errors) - 3} more failures", "Same kind of problem as above.", ""))
        return first
    except Refused as e:
        return [Issue(row.label, str(e), "Blocked by the safety guard; nothing was deleted.", "Delete it by hand if you are sure.")]
    except CmdError as e:
        return [issue(f"{row.label}  ({e.cmd})", str(e))]
    except Exception as e:
        return [issue(row.label, f"{type(e).__name__}: {e}")]
    return []


def gui():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import GLib, GObject, Gdk, Gtk

    try:  # GTK/GLib warnings are noise on the CLI
        GLib.log_set_writer_func(lambda *a: GLib.LogWriterOutput.HANDLED, None)
    except Exception:
        pass
    GLib.set_prgname("disk-cleaner")
    GLib.set_application_name("Disk Cleaner")
    icon = os.path.join(os.path.dirname(os.path.realpath(__file__)), "disk-cleaner.svg")
    if os.path.exists(icon):  # fallback when the icon theme entry is not installed
        Gtk.Window.set_default_icon_from_file(icon)

    store = Gtk.ListStore(bool, str, GObject.TYPE_INT64, str, str, str)  # sel, label, size, target, kind, note
    status = Gtk.Label(xalign=0)
    usage = Gtk.ProgressBar(show_text=True)
    win = Gtk.Window(title="Disk Cleaner", default_width=1150, default_height=650, icon_name="disk-cleaner")
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=8)
    win.add(box)

    def is_dark():
        c = tree.get_style_context().get_color(Gtk.StateFlags.NORMAL)
        return (c.red + c.green + c.blue) / 3 > 0.5

    @functools.lru_cache(None)  # cleared by refresh() whenever sizes change
    def layout():
        sl = pie_slices(list(store), PALETTE["dark" if is_dark() else "light"])
        return sl, {x["rows"][0][1]: x["color"] for x in sl if len(x["rows"]) == 1}

    def rgb(h):
        return tuple(int(h[i:i + 2], 16) / 255 for i in (1, 3, 5))

    def refresh(msg=""):
        u = shutil.disk_usage("/")
        usage.set_fraction(u.used / u.total)
        usage.set_text(f"/  {human(u.used)} used of {human(u.total)}  ({human(u.free)} free)")
        sel = sum(r[2] for r in store if r[0])
        status.set_text(f"selected {human(sel)}  {msg}")
        layout.cache_clear()
        pie.queue_draw()
        tree.queue_draw()

    pie = Gtk.DrawingArea(width_request=380, height_request=380)
    pie.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
    geom = {}

    def draw(area, cr):
        w, h = area.get_allocated_width(), area.get_allocated_height()
        cx, cy = w / 2, h / 2
        R = min(w, h) / 2 - 20
        r = R * 0.58
        sc = tree.get_style_context()
        fg, bg = sc.get_color(Gtk.StateFlags.NORMAL), sc.get_background_color(Gtk.StateFlags.NORMAL)
        sl = layout()[0]
        total = sum(s["size"] for s in sl)
        geom.update(cx=cx, cy=cy, R=R, r=r, slices=[])
        if total:
            a = 0.0
            for s in sl:
                da = 2 * math.pi * s["size"] / total
                mid, off = a + da / 2 - math.pi / 2, (10 if any(x[0] for x in s["rows"]) else 0)  # selected slices pop out
                ox, oy = cx + off * math.cos(mid), cy + off * math.sin(mid)
                cr.new_path()
                cr.arc(ox, oy, R, a - math.pi / 2, a + da - math.pi / 2)
                cr.arc_negative(ox, oy, r, a + da - math.pi / 2, a - math.pi / 2)
                cr.close_path()
                cr.set_source_rgb(*rgb(s["color"]))
                cr.fill_preserve()
                cr.set_source_rgb(bg.red, bg.green, bg.blue)  # 2px surface gap between slices
                cr.set_line_width(2)
                cr.stroke()
                geom["slices"].append((a, a + da, s, s["size"] / total))
                a += da
        sel = sum(x[2] for x in store if x[0])
        lines = [("selected" if sel else "reclaimable", 12), (human(sel if sel else total), 22)]
        y = cy - 4
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 1)
        for text, size in lines:
            cr.set_font_size(size)
            ext = cr.text_extents(text)
            cr.move_to(cx - ext.width / 2 - ext.x_bearing, y)
            cr.show_text(text)
            y += size + 6

    def slice_at(ev):
        dx, dy = ev.x - geom.get("cx", 0), ev.y - geom.get("cy", 0)
        if not geom.get("slices") or not geom["r"] <= math.hypot(dx, dy) <= geom["R"] + 10:
            return None
        ang = (math.atan2(dy, dx) + math.pi / 2) % (2 * math.pi)
        return next((x for x in geom["slices"] if x[0] <= ang < x[1]), None)

    def on_motion(_, ev):
        x = slice_at(ev)
        pie.set_tooltip_text(f"{x[2]['label']}\n{human(x[2]['size'])}  ({x[3]:.0%})" if x else None)

    def on_click(_, ev):
        x = slice_at(ev)
        if x and len(x[2]["rows"]) == 1:
            x[2]["rows"][0][0] = not x[2]["rows"][0][0]
            refresh()

    pie.connect("draw", draw)
    pie.connect("motion-notify-event", on_motion)
    pie.connect("button-press-event", on_click)

    def on_toggle(_, path):
        store[path][0] = not store[path][0]
        refresh()

    tree = Gtk.TreeView(model=store)
    tog = Gtk.CellRendererToggle()
    tog.connect("toggled", on_toggle)
    tree.append_column(Gtk.TreeViewColumn("", tog, active=0))
    dot = Gtk.TreeViewColumn("", Gtk.CellRendererText(text="●"))
    dot.set_cell_data_func(dot.get_cells()[0], lambda c, r, m, i, _: r.set_property(
        "foreground", layout()[1].get(m[i][1], OTHER)))
    tree.append_column(dot)
    warn = Gtk.TreeViewColumn("", Gtk.CellRendererText(foreground="#eda100"))
    warn.set_cell_data_func(warn.get_cells()[0], lambda c, r, m, i, _: r.set_property("text", "⚠" if m[i][5] else ""))
    tree.append_column(warn)
    tree.set_tooltip_column(5)
    item_col = Gtk.TreeViewColumn("Item", Gtk.CellRendererText(ellipsize=3), text=1)
    item_col.set_expand(True)
    item_col.set_sort_column_id(1)
    tree.append_column(item_col)
    size_col = Gtk.TreeViewColumn("Size", Gtk.CellRendererText(xalign=1), text=2)
    size_col.set_cell_data_func(size_col.get_cells()[0], lambda c, r, m, i, _: r.set_property("text", human(m[i][2])))
    size_col.set_sort_column_id(2)
    tree.append_column(size_col)
    store.set_sort_column_id(2, Gtk.SortType.DESCENDING)
    sw = Gtk.ScrolledWindow(vexpand=True, hexpand=True)
    sw.add(tree)

    scan_btn, del_btn, issues_btn = Gtk.Button(label="Rescan"), Gtk.Button(label="Delete selected"), Gtk.Button()
    bar = Gtk.Box(spacing=6)
    bar.pack_start(status, True, True, 0)
    bar.pack_end(del_btn, False, False, 0)
    bar.pack_end(scan_btn, False, False, 0)
    bar.pack_end(issues_btn, False, False, 0)
    main = Gtk.Box(spacing=8)
    main.pack_start(pie, False, False, 0)
    main.pack_start(sw, True, True, 0)
    box.pack_start(usage, False, False, 0)
    box.pack_start(main, True, True, 0)
    box.pack_start(bar, False, False, 0)

    def all_issues():
        return ISSUES["run"] + ISSUES["scan"]

    def update_issues_btn():
        n = len(all_issues())
        issues_btn.set_label(f"⚠ Problems ({n})")
        issues_btn.set_visible(n > 0)

    def show_issues(items):
        d = Gtk.Dialog(title="Problems", transient_for=win, default_width=780, default_height=480)
        d.add_button("Close", Gtk.ResponseType.CLOSE)
        text = issues_text(items)
        tv = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD, left_margin=10, top_margin=10)
        tv.get_buffer().set_text(text)
        sw_ = Gtk.ScrolledWindow(vexpand=True)
        sw_.add(tv)
        d.get_content_area().pack_start(sw_, True, True, 0)
        d.show_all()
        d.run()
        d.destroy()

    def crash(et, ev, tb):  # unexpected exceptions are shown, not printed
        where = traceback.extract_tb(tb)[-1] if tb else None
        ISSUES["run"].append(Issue("internal error", "".join(traceback.format_exception_only(et, ev)).strip()
                                   + (f" ({os.path.basename(where.filename)}:{where.lineno} in {where.name})" if where else ""),
                                   "A bug in disk-cleaner.", "Report it with the text above."))
        GLib.idle_add(update_issues_btn)
    sys.excepthook = crash
    threading.excepthook = lambda a: crash(a.exc_type, a.exc_value, a.exc_traceback)

    def add(row):
        if row.size > 0:
            store.append([False, row.label, row.size, row.target, row.kind, row.note])
            refresh("(scanning...)")

    def do_scan(_=None):
        store.clear()
        scan_btn.set_sensitive(False)

        def done():
            scan_btn.set_sensitive(True)
            update_issues_btn()
            n = len(ISSUES["scan"])
            refresh("done" + (f" - {n} unreadable paths, sizes may be low" if n else ""))

        def work():
            try:
                for row in scan():
                    GLib.idle_add(add, row)
            finally:
                GLib.idle_add(done)
        threading.Thread(target=work, daemon=True).start()

    def do_delete(_):
        rows = [Row(r[1], r[3], r[2], r[4], r[5]) for r in store if r[0]]
        if not rows:
            return
        direct, cmds = [r for r in rows if r.kind != "cmd"], [r for r in rows if r.kind == "cmd"]
        d = Gtk.MessageDialog(transient_for=win, message_type=Gtk.MessageType.WARNING,
                              buttons=Gtk.ButtonsType.OK_CANCEL,
                              text=f"Delete {len(rows)} items ({human(sum(r.size for r in rows))})?")
        warns = [f"⚠ {r.label}: {r.note}" for r in rows if r.note]
        d.format_secondary_text(
            (("Permanently deleted now:\n" + "\n".join(f"  {r.label}" for r in direct) + "\n\n") if direct else "")
            + (("Run in a terminal (the package manager / sudo asks for confirmation there):\n"
                + "\n".join(f"  {r.target}" for r in cmds) + "\n\n") if cmds else "")
            + "\n".join(warns))
        d.set_default_response(Gtk.ResponseType.CANCEL)
        ok = d.run() == Gtk.ResponseType.OK
        d.destroy()
        if not ok:
            return
        del_btn.set_sensitive(False)
        ISSUES["run"].clear()

        def work():
            for r in direct + cmds:
                GLib.idle_add(refresh, f"deleting {r.label}...")
                ISSUES["run"] += run_job(r)
            GLib.idle_add(finish)

        def finish():
            del_btn.set_sensitive(True)
            update_issues_btn()
            if ISSUES["run"]:
                show_issues(ISSUES["run"])
            do_scan()
        threading.Thread(target=work, daemon=True).start()

    issues_btn.connect("clicked", lambda _: show_issues(all_issues()))
    issues_btn.set_no_show_all(True)
    scan_btn.connect("clicked", do_scan)
    del_btn.connect("clicked", do_delete)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    do_scan()
    Gtk.main()


if __name__ == "__main__":
    if "--list" in sys.argv:
        for r in sorted(scan(), key=lambda r: -r.size):
            print(f"{human(r.size):>9}  {r.kind:5} {r.label}" + (f"  [!] {r.note}" if r.note else ""))
        for i in ISSUES["scan"]:
            print(f"problem: {i.item}: {i.cause} -> {i.hint}")
    else:
        gui()
